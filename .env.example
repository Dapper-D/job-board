# Copy this file to .env for local runs. .env is git-ignored: never commit it.
# On GitHub, use repository secrets and variables instead (see README).

# Where your profile lives (defaults to profile.toml next to config.toml).
PROFILE_PATH=profile.toml

# Optional AI scoring. Leave LLM_PROVIDER=none to use the free keyword scorer.
# Providers: anthropic | openai | gemini | openai-compatible | ollama | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Only for openai-compatible or ollama, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=
